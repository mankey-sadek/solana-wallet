# === Target wallet to copy (from the gmgn.ai link you're following) ===
TARGET_WALLET=Cw9YHB19L6hdiCBaF9sXPAQNp9Wr1P9n5MrarZsZhYxC

# === Solana RPC (use a real provider for reliability: Helius, QuickNode, Triton, etc.) ===
# Public RPCs are rate-limited and drop websocket subscriptions under load; do not rely on them for live trading.
RPC_HTTP_URL=https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://api.mainnet-beta.solana.com

# === Run mode ===
# dry-run: only simulate/log trades via Jupiter quotes, never sends a real transaction.
# live: signs and sends real swap transactions with MY_WALLET_PRIVATE_KEY. Real money at risk.
MODE=dry-run

# === Your wallet (only required for MODE=live) ===
# Base58-encoded secret key (as printed by `solana-keygen` / Phantom export). NEVER commit this file.
MY_WALLET_PRIVATE_KEY=

# === Position sizing ===
# The bot mirrors the *percentage of SOL balance* the target wallet risks on each trade, applied to
# your own SOL balance. E.g. target spends 10% of its SOL on a buy -> bot spends COPY_RATIO * 10% of yours.
# 1.0 = mirror their balance-percentage exactly, 0.5 = trade at half their relative size, etc.
COPY_RATIO=0.1

# Safety caps (in SOL)
MIN_TRADE_SOL=0.01
MAX_TRADE_SOL=1
# SOL kept untouched for fees/rent, never spent on a buy
RESERVE_SOL=0.05

# Ignore source trades smaller than this (SOL) - filters out dust/noise
MIN_SOURCE_TRADE_SOL=0.02

# Slippage tolerance for our own swaps (basis points, 100 = 1%)
SLIPPAGE_BPS=150

# Jupiter API base (public, no key required)
JUPITER_API_URL=https://quote-api.jup.ag/v6
